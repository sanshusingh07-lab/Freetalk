# FreeTalk Environment Configuration Template
# Copy to .env and adjust variables as needed. NEVER commit .env to version control.

# --- Core Server ---
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:password@localhost:5432/freetalk?schema=public"
FRONTEND_URL="http://localhost:5173"
MODERATION_SERVICE_URL="http://localhost:8000"

# --- Security & Cryptography ---
JWT_SECRET="replace_with_a_cryptographically_secure_jwt_secret_min_32_chars"
COOKIE_SECRET="replace_with_a_cryptographically_secure_cookie_secret_min_32_chars"
SEED_ADMIN_PASSWORD="Password123!"

# --- Google OAuth Configuration ---
# Obtain from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# --- Tiered Rate Limiting (All thresholds are configurable) ---
# Auth routes (login, signup, password reset)
RATE_LIMIT_AUTH_WINDOW_MS=900000       # 15 minutes in ms
RATE_LIMIT_AUTH_MAX_IP=15              # Max requests per IP in window
RATE_LIMIT_AUTH_ACCOUNT_MAX=5          # Consecutive failures before exponential backoff
RATE_LIMIT_AUTH_MAX_BACKOFF_SEC=900    # Max backoff delay (15 min)

# Public endpoints (topics, public feeds, exploration)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000     # 15 minutes in ms
RATE_LIMIT_PUBLIC_MAX=300              # Max requests per IP in window

# Authenticated user actions
RATE_LIMIT_USER_WINDOW_MS=60000        # 1 minute in ms
RATE_LIMIT_USER_MAX=120                # Max requests per user in window
RATE_LIMIT_POST_MAX=10                 # Max posts per minute
RATE_LIMIT_COMMENT_MAX=25              # Max comments per minute
RATE_LIMIT_MESSAGE_MAX=40              # Max personal messages per minute
RATE_LIMIT_REPORT_MAX=5                # Max reports per minute

# --- File Upload Safety ---
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5

# --- Email Notifications ---
EMAIL_FROM="FreeTalk Security <notifications@freetalk.internal>"
# Optional external SMTP configuration:
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT=587
# SMTP_USER="your_smtp_user"
# SMTP_PASS="your_smtp_pass"
# SMTP_SECURE=false
